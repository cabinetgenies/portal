# Cabinet Genies Portal — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API keys).
#
# Both of these are REQUIRED. They are safe to expose to the browser — access to
# data is enforced by Row Level Security policies in the database, not by
# hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL. Server-assisted, and public by design — it is a URL, not a secret.
# The origin Google sign-in sends people back to (for example
# https://portal.cabinetgenies.com or http://localhost:3000). When it is unset
# the portal falls back to the request's own host header, which is fine locally
# and less precise in production. It must match an entry in Supabase's redirect
# allow-list, or Supabase will refuse the callback.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL. Server-only. Only needed for privileged server-side administration
# (creating or deleting auth users, bypassing RLS). Never prefix this with
# NEXT_PUBLIC_ and never import it into client code.
# SUPABASE_SERVICE_ROLE_KEY=

# NOTE on Google OAuth: the Google client id and client secret are NOT
# environment variables for this application. They are configured once in
# Supabase (Authentication → Providers → Google) and in Google Cloud, and the
# portal never reads them. See docs/google-sign-in.md.
