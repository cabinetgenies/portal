# Cabinet Genies Portal — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API keys).
#
# Both of these are REQUIRED. They are safe to expose to the browser — access to
# data is enforced by Row Level Security policies in the database, not by
# hiding the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL. Server-only. Only needed for privileged server-side administration
# (creating or deleting auth users, bypassing RLS). Never prefix this with
# NEXT_PUBLIC_ and never import it into client code.
# SUPABASE_SERVICE_ROLE_KEY=
